{
  "name": "jev-enforce",
  "version": "1.0.0",
  "description": "Make Claude Code actually follow your CLAUDE.md, checked by TypeSafe Jev",
  "type": "module",
  "bin": {
    "jev-enforce": "dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "hooks",
    ".claude-plugin"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "build": "tsc -p .",
    "test": "tsc -p . && node --test dist/test/*.test.js",
    "check-dist": "tsc -p . && git diff --exit-code -- dist/src",
    "bench": "tsc -p . && node dist/bench/run.js"
  },
  "keywords": [
    "claude-code",
    "claude-md",
    "jev",
    "typesafe",
    "hooks"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.6.2",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/erkamyaman/jev-enforce.git"
  },
  "homepage": "https://github.com/erkamyaman/jev-enforce#readme",
  "bugs": {
    "url": "https://github.com/erkamyaman/jev-enforce/issues"
  },
  "author": "erkamyaman"
}